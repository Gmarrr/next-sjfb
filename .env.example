# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key

# Server-only (contact form + admin tasks). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_secret_key

# Public site URL — used for SEO links, sitemap and images inside emails
NEXT_PUBLIC_SITE_URL=https://fishbrokers.net

# Email (contact form notifications). Resend is used when RESEND_API_KEY is set;
# otherwise BREVO_API_KEY is used. MAIL_FROM must be an address on a domain verified in that service.
RESEND_API_KEY=re_your_resend_api_key
# BREVO_API_KEY=xkeysib-...
MAIL_FROM=website@fishbrokers.net
MAIL_FROM_NAME="St. Joseph Fish Brokerage Inc."
ADMIN_EMAIL=you@fishbrokers.net
