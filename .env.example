# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Server-only (used by the contact form API). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public site URL (used for SEO canonical links / sitemap)
NEXT_PUBLIC_SITE_URL=https://next-sjfb.vercel.app

# Brevo (transactional email for contact form notifications)
BREVO_API_KEY=your_brevo_api_key
MAIL_FROM=marketing@fishbrokers.net
MAIL_FROM_NAME="St. Joseph Fish Brokerage Inc."
ADMIN_EMAIL=j.denuevo@fishbrokers.net
